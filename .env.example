# Copy to .env and edit:  cp .env.example .env
# Every value here is optional — the defaults in docker-compose.yml are sane.

# ---------- Identity ----------
SERVER_NAME=Murder Mystery Escape
LEVEL_NAME=mystery
TZ=America/Los_Angeles

# ---------- Build phase vs play phase ----------
# BUILDING the map (default): creative + peaceful + operator, so you can fly and edit.
GAMEMODE=creative
DIFFICULTY=peaceful
DEFAULT_PLAYER_PERMISSION_LEVEL=operator
ALLOW_CHEATS=true
LEVEL_TYPE=flat

# PLAYTESTING the map: swap to these, then `docker compose up -d` to apply.
#   GAMEMODE=adventure
#   DIFFICULTY=normal
#   DEFAULT_PLAYER_PERMISSION_LEVEL=member
#   ALLOW_CHEATS=true          # keep true so command blocks / your op commands still work
#   LEVEL_TYPE=default

# ---------- Access control ----------
# ONLINE_MODE=true requires Xbox Live auth. Keep it true on a public/cloud host.
ONLINE_MODE=true

# Lock the server to invited players only. Strongly recommended on a cloud host.
ALLOW_LIST=false
# Comma-separated "Gamertag:XUID" pairs. XUID shows in the logs after a first join
# attempt, so it's normal to start with ALLOW_LIST=false, let people connect once,
# read their XUIDs from `docker compose logs`, then fill this in and flip to true.
ALLOW_LIST_USERS=

# Comma-separated gamertags or XUIDs.
OPS=
MEMBERS=
VISITORS=

MAX_PLAYERS=10

# ---------- Importing a map ----------
# Put the archive in ./packs/, then set the in-container path:
#   MC_PACK=/packs/murder-mystery-escape.mcworld
# Accepts .mcworld, .mcaddon, .mcpack and .zip.
MC_PACK=
# true = re-copy the archive over the live world on EVERY restart. Leave false once
# you start building, or you will silently throw away in-game progress.
FORCE_WORLD_COPY=false

# ---------- Performance / networking ----------
VERSION=LATEST
VIEW_DISTANCE=16
TICK_DISTANCE=4
PLAYER_IDLE_TIMEOUT=0
TEXTUREPACK_REQUIRED=false
MEMORY_LIMIT=2g
SERVER_PORT=19132
SERVER_PORT_V6=19133
STOP_SERVER_ANNOUNCE_DELAY=10
